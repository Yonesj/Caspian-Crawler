# Copy to .env and fill in real values. Never commit the populated .env.

# GENERAL
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-string
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE
# ------------------------------------------------------------------------------
# Either provide a single DATABASE_URL ...
# DATABASE_URL=postgres://north_estate_user:password@127.0.0.1:5432/north_estate_db
# ... or the individual POSTGRES_* variables.
POSTGRES_DB=north_estate_db
POSTGRES_USER=north_estate_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# REDIS (Celery broker/result backend, shared cache and throttling)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
