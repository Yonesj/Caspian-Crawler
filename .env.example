# Copy to .env and fill in real values. Never commit the populated .env.

# GENERAL
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-string
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE
# ------------------------------------------------------------------------------
# Either provide a single DATABASE_URL ...
# DATABASE_URL=postgres://north_estate_user:password@127.0.0.1:5432/north_estate_db
# ... or the individual POSTGRES_* variables.
POSTGRES_DB=north_estate_db
POSTGRES_USER=north_estate_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# REDIS (shared rate-limit buckets, Celery broker and result backend)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# BACKGROUND JOBS
# ------------------------------------------------------------------------------
# Periodic crawls are opt-in: the flag registers the beat entry and a CrawlSchedule
# row must also exist and be enabled.  Set the flag on the *beat* process.
# CELERY_BEAT_ENABLED=true
# CRAWL_SCHEDULE_TICK_SECONDS=60
# CELERY_TASK_TIME_LIMIT=1800
# CELERY_TASK_SOFT_TIME_LIMIT=1500

# CRAWLING (optional; defaults are deliberately slow and polite)
# ------------------------------------------------------------------------------
# CRAWL_USER_AGENT=NorthEstate/0.1 (research crawler; contact you@example.com)
# CRAWL_RATE_LIMIT_BACKEND=memory      # memory | redis (redis is the production default)
# CRAWL_DIVAR_REQUESTS_PER_SECOND=0.5
# CRAWL_SHEYPOOR_REQUESTS_PER_SECOND=0.33
# CRAWL_DIVAR_MAX_ATTEMPTS=4
