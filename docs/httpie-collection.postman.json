{
  "info": {
    "_postman_id": "8fd0f499-2590-4de7-b4b0-90f04586597b",
    "name": "CaspianCrawler API — HTTPie Desktop",
    "description": "Import this Postman Collection v2.1 file into HTTPie Desktop or Postman. Start the Django API, PostgreSQL, Redis, and the Celery worker first; the local Compose stack applies migrations and seeds locations and source categories automatically. Create a staff operator with `python manage.py createsuperuser`, then set the username and password collection variables. Run the numbered folders in order where state matters. Obtain a JWT first and, if the client does not run imported Postman test scripts, manually copy response values into the access_token, refresh_token, crawl-job ID, and listing ID variables. The numeric location defaults match a clean import of core/locations/data/locations.json; use the selector requests and update them if an existing database has different primary keys. Listing status is intentionally not writable through the API: the lifecycle sweep performs active → stale → delisted transitions, while authenticated staff requests can inspect those states.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
